// =============================================================================
// Beverage POS System — Prisma Schema
// =============================================================================
// Derived from frontend TypeScript interfaces in src/types/index.ts
// Naming convention: camelCase in TypeScript <-> snake_case in PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  worker
}

enum ProductCategory {
  soft_drink    @map("soft-drink")
  juice
  water
  energy_drink  @map("energy-drink")
}

enum AdjustmentReason {
  damage
  theft
  manual_correction @map("manual-correction")
}

enum PriceTier {
  standard
  premium
  discount
}

enum LedgerEntryType {
  sale
  payment
  return      @map("return")
  adjustment
}

enum LedgerPaymentMode {
  cash
  bank_transfer @map("bank-transfer")
  check
}

enum BillPaymentMode {
  cash
  credit
  udhar
  generate_only @map("generate-only")
}

enum BillStatus {
  pending
  paid
  partial
}

// ─── Models ───────────────────────────────────────────────────────────────────

// ----------------------------------------------------------------------------
// User — Represents anyone with system access (Admin or Worker)
// One login page → role determines dashboard visibility
// ----------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  stockAdjustments StockAdjustment[] @relation("AdminAdjustments")
  billsCreated     Bill[]            @relation("WorkerBills")
  priceChanges     PriceHistory[]    @relation("AdminPriceChanges")
  voidedBillLogs   VoidedBillLog[]   @relation("WorkerVoids")

  @@map("users")
}

// ----------------------------------------------------------------------------
// Product — A sellable beverage item
// ----------------------------------------------------------------------------
model Product {
  id                  String          @id @default(uuid())
  brand               String
  category            ProductCategory
  variant             String
  petConversionFactor Int             @map("pet_conversion_factor")
  description         String?

  // Relations
  stockBatches StockBatch[]
  billItems    BillItem[]
  priceHistory PriceHistory[]

  @@map("products")
}

// ----------------------------------------------------------------------------
// StockBatch — A specific shipment of a Product (FIFO depletion applies)
// ----------------------------------------------------------------------------
model StockBatch {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  quantity     Int      // Current stock level in PET units
  buyPrice     Decimal  @map("buy_price")   @db.Decimal(10, 2)
  salePrice    Decimal  @map("sale_price")  @db.Decimal(10, 2)
  batchNumber  String   @unique @map("batch_number")
  expiryDate   DateTime @map("expiry_date")
  purchaseDate DateTime @map("purchase_date")
  supplierId   String?  @map("supplier_id") // Loose string — no supplier table yet
  supplier     String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  product     Product           @relation(fields: [productId], references: [id])
  adjustments StockAdjustment[]

  @@index([productId])
  @@index([expiryDate])
  @@map("stock_batches")
}

// ----------------------------------------------------------------------------
// StockAdjustment — Audited manual deduction outside a sales transaction
// Business rule: must include reason + admin ID
// ----------------------------------------------------------------------------
model StockAdjustment {
  id        String           @id @default(uuid())
  batchId   String           @map("batch_id")
  quantity  Int              // Positive = add, Negative = remove
  reason    AdjustmentReason
  notes     String
  adminId   String           @map("admin_id")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  batch StockBatch @relation(fields: [batchId], references: [id])
  admin User       @relation("AdminAdjustments", fields: [adminId], references: [id])

  @@map("stock_adjustments")
}

// ----------------------------------------------------------------------------
// Retailer — A customer shop (wholesale buyer)
// ----------------------------------------------------------------------------
model Retailer {
  id               String    @id @default(uuid())
  shopName         String    @map("shop_name")
  ownerName        String    @map("owner_name")
  mobileNumber     String    @map("mobile_number")
  address          String
  deliveryLocation String?   @map("delivery_location")
  creditLimit      Decimal   @map("credit_limit") @db.Decimal(12, 2)
  priceTier        PriceTier @default(standard)   @map("price_tier")
  createdAt        DateTime  @default(now())       @map("created_at")

  // Relations
  bills         Bill[]
  ledgerEntries LedgerEntry[]
  rgbTracking   RGBTracking?

  @@map("retailers")
}

// ----------------------------------------------------------------------------
// LedgerEntry — Running balance per retailer (sale → increase, payment → decrease)
// Business rule: balance must always reflect sum of unpaid bills minus payments
// ----------------------------------------------------------------------------
model LedgerEntry {
  id          String             @id @default(uuid())
  retailerId  String             @map("retailer_id")
  billId      String?            @map("bill_id")
  entryType   LedgerEntryType    @map("entry_type")
  amount      Decimal            @db.Decimal(12, 2)
  balance     Decimal            @db.Decimal(12, 2) // Running total after this entry
  paymentMode LedgerPaymentMode? @map("payment_mode")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])
  bill     Bill?    @relation(fields: [billId], references: [id])

  @@index([retailerId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ----------------------------------------------------------------------------
// RGBTracking — Returnable Glass Bottle (crate) asset tracking per retailer
// Business rule: crate balance is independent of monetary payment
// ----------------------------------------------------------------------------
model RGBTracking {
  id               String   @id @default(uuid())
  retailerId       String   @unique @map("retailer_id") // One record per retailer
  issuedQuantity   Int      @default(0)   @map("issued_quantity")
  returnedQuantity Int      @default(0)   @map("returned_quantity")
  balance          Int      @default(0)   // issuedQuantity - returnedQuantity
  lastUpdated      DateTime @default(now()) @updatedAt @map("last_updated")

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])

  @@map("rgb_tracking")
}

// ----------------------------------------------------------------------------
// Bill — A finalized sales invoice
// Business rule: immutable after creation (Worker cannot edit/delete)
// ----------------------------------------------------------------------------
model Bill {
  id                       String           @id @default(uuid())
  billNumber               String           @unique @map("bill_number")
  retailerId               String           @map("retailer_id")
  workerId                 String           @map("worker_id")
  subtotal                 Decimal          @db.Decimal(12, 2)
  discount                 Decimal          @default(0)          @db.Decimal(12, 2)
  total                    Decimal          @db.Decimal(12, 2)
  paidAmount               Decimal          @default(0) @map("paid_amount")             @db.Decimal(12, 2)
  pendingAmount            Decimal          @map("pending_amount")                       @db.Decimal(12, 2)
  paymentMode              BillPaymentMode? @map("payment_mode")
  previousPendingAdded     Decimal?         @map("previous_pending_added")              @db.Decimal(12, 2)
  oldPendingPaymentApplied Decimal?         @map("old_pending_payment_applied")         @db.Decimal(12, 2)
  status                   BillStatus
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt      @map("updated_at")

  // Relations
  retailer       Retailer        @relation(fields: [retailerId], references: [id])
  worker         User            @relation("WorkerBills", fields: [workerId], references: [id])
  items          BillItem[]
  paymentHistory PaymentRecord[]
  ledgerEntries  LedgerEntry[]
  voidLog        VoidedBillLog?

  @@index([retailerId])
  @@index([workerId])
  @@index([createdAt])
  @@map("bills")
}

// ----------------------------------------------------------------------------
// BillItem — Individual product line within a Bill
// ----------------------------------------------------------------------------
model BillItem {
  id        String  @id @default(uuid())
  billId    String  @map("bill_id")
  productId String  @map("product_id")
  quantity  Int     // In PET units
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(12, 2) // (quantity * price) - discount

  // Relations
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
  @@map("bill_items")
}

// ----------------------------------------------------------------------------
// PaymentRecord — Historical partial/full payment applied against a Bill
// ----------------------------------------------------------------------------
model PaymentRecord {
  id          String          @id @default(uuid())
  billId      String          @map("bill_id")
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  paymentMode BillPaymentMode @map("payment_mode")
  notes       String?

  // Relations
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

// ----------------------------------------------------------------------------
// PriceHistory — Audit log when Admin changes a product's default price
// ----------------------------------------------------------------------------
model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(10, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(10, 2)
  changedBy String   @map("changed_by") // Admin user ID
  date      DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id])
  admin   User    @relation("AdminPriceChanges", fields: [changedBy], references: [id])

  @@index([productId])
  @@map("price_history")
}

// ----------------------------------------------------------------------------
// VoidedBillLog — Soft-delete audit trail for cancelled bills
// Business rule: bills are NEVER hard-deleted; prevents "ghost transactions"
// ----------------------------------------------------------------------------
model VoidedBillLog {
  id        String   @id @default(uuid())
  billId    String   @unique @map("bill_id")  // One void log per bill
  workerId  String   @map("worker_id")        // Worker who originally created the bill
  voidedAt  DateTime @default(now()) @map("voided_at")
  billValue Decimal  @map("bill_value") @db.Decimal(12, 2)
  reason    String   // Required explanation

  // Relations
  bill   Bill @relation(fields: [billId], references: [id])
  worker User @relation("WorkerVoids", fields: [workerId], references: [id])

  @@map("voided_bill_logs")
}
