// =============================================================================
// Beverage POS System — Prisma Schema
// =============================================================================
// Derived from frontend TypeScript interfaces in src/types/index.ts
// Naming convention: camelCase in TypeScript <-> snake_case in PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  worker
}

enum ExpenseCategory {
  fuel
  salary
  delivery
  electricity
  maintenance
  other
}


enum AdjustmentReason {
  damage
  theft
  manual_correction @map("manual-correction")
}


enum LedgerEntryType {
  sale
  payment
  return      @map("return")
  adjustment
}

enum LedgerPaymentMode {
  cash
  bank_transfer @map("bank-transfer")
  check
}

enum BillPaymentMode {
  cash
  credit
  udhar
  generate_only @map("generate-only")
}

enum BillStatus {
  pending
  paid
  partial
}

enum RGBTransactionType {
  ISSUE
  RETURN
}

enum ReminderStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

// ----------------------------------------------------------------------------
// User — Represents anyone with system access (Admin or Worker)
// Login is username-based. Admin's username is "admin".
// Admin assigns usernames to workers when creating their accounts.
// ----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  name         String
  username     String?   @unique               // login identifier (lowercase); seeded on all rows
  email        String?   @unique               // optional, kept for records
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  cnic         String?   // National ID (workers)
  phone        String?   // Phone number
  joinDate     DateTime? @map("join_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  stockAdjustments StockAdjustment[] @relation("AdminAdjustments")
  billsCreated     Bill[]            @relation("WorkerBills")
  priceChanges     PriceHistory[]    @relation("AdminPriceChanges")
  voidedBillLogs   VoidedBillLog[]   @relation("WorkerVoids")
  expensesCreated  Expense[]         @relation("ExpenseCreator")
  paymentReminders PaymentReminder[] @relation("ReminderCreator")

  @@map("users")
}

// ----------------------------------------------------------------------------
// Brand — A product brand (e.g. "pepsi", "coca cola", "sprite")
// One Brand → many Products (variants). Image is stored at brand level so all
// variants under the same brand automatically share the same image.
// name is always lowercase + trimmed. displayName can have original casing.
// ----------------------------------------------------------------------------
model Brand {
  id          String   @id @default(uuid())
  name        String   @unique              // normalized lowercase key (e.g. "pepsi")
  displayName String   @map("display_name") // shown in UI (e.g. "Pepsi")
  imageUrl    String?  @map("image_url")    // /uploads/brands/abc.jpg
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt           @map("updated_at")

  products Product[]

  @@map("brands")
}

// ----------------------------------------------------------------------------
// Product — A sellable item (beverage, snack, general grocery, etc.)
// category is a free-text string — no enum lock-in.
// Products are always sold by PET unit. No bottle/conversion ratio needed.
// isActive: false = soft-deleted (hidden from lists, cannot be sold).
// brand string is kept for backward compat during migration but brandId is the
// authoritative FK going forward.
// variant is always lowercase + trimmed. @@unique enforced at DB level.
// ----------------------------------------------------------------------------
model Product {
  id          String   @id @default(uuid())
  brandId     String   @map("brand_id")     // FK → Brand
  brand       String                         // kept for backward compat during migration
  category    String   @default("general")  // free-text: no enum lock-in
  variant     String                         // e.g. "1.5l pet", "500ml can"
  description String?
  imageUrl    String?  @map("image_url")    // kept for data safety; not used going forward
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  brandRel     Brand         @relation(fields: [brandId], references: [id])
  stockBatches StockBatch[]
  billItems    BillItem[]
  priceHistory PriceHistory[]

  @@unique([brandId, variant])              // dedup by brandId+variant (replaces old brand string+variant)
  @@map("products")
}


// ----------------------------------------------------------------------------
// StockBatch — A specific shipment of a Product (FIFO depletion applies)
// ----------------------------------------------------------------------------
model StockBatch {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  quantity     Int      // Current stock level in PET units
  buyPrice     Decimal  @map("buy_price")   @db.Decimal(10, 2)
  salePrice    Decimal  @map("sale_price")  @db.Decimal(10, 2)
  batchNumber  String   @unique @map("batch_number")
  expiryDate   DateTime @map("expiry_date")
  purchaseDate DateTime @map("purchase_date")
  supplierId   String?  @map("supplier_id") // Loose string — no supplier table yet
  supplier     String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  product     Product           @relation(fields: [productId], references: [id])
  adjustments StockAdjustment[]

  @@index([productId])
  @@index([expiryDate])
  @@map("stock_batches")
}

// ----------------------------------------------------------------------------
// StockAdjustment — Audited manual deduction outside a sales transaction
// Business rule: must include reason + admin ID
// ----------------------------------------------------------------------------
model StockAdjustment {
  id        String           @id @default(uuid())
  batchId   String           @map("batch_id")
  quantity  Int              // Positive = add, Negative = remove
  reason    AdjustmentReason
  notes     String
  adminId   String           @map("admin_id")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  batch StockBatch @relation(fields: [batchId], references: [id])
  admin User       @relation("AdminAdjustments", fields: [adminId], references: [id])

  @@map("stock_adjustments")
}

// ----------------------------------------------------------------------------
// Retailer — A customer shop (wholesale buyer)
// ----------------------------------------------------------------------------
model Retailer {
  id               String    @id @default(uuid())
  shopName         String    @map("shop_name")
  ownerName        String    @map("owner_name")
  mobileNumber     String    @map("mobile_number")
  address          String
  deliveryLocation String?   @map("delivery_location")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  bills            Bill[]
  ledgerEntries    LedgerEntry[]
  rgbBalances      RGBRetailerBalance[]
  paymentReminders PaymentReminder[]

  @@map("retailers")
}

// ----------------------------------------------------------------------------
// LedgerEntry — Running balance per retailer (sale → increase, payment → decrease)
// Business rule: balance must always reflect sum of unpaid bills minus payments
// ----------------------------------------------------------------------------
model LedgerEntry {
  id          String             @id @default(uuid())
  retailerId  String             @map("retailer_id")
  billId      String?            @map("bill_id")
  entryType   LedgerEntryType    @map("entry_type")
  amount      Decimal            @db.Decimal(12, 2)
  balance     Decimal            @db.Decimal(12, 2) // Running total after this entry
  paymentMode LedgerPaymentMode? @map("payment_mode")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])
  bill     Bill?    @relation(fields: [billId], references: [id])

  @@index([retailerId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ----------------------------------------------------------------------------
// Bill — A finalized sales invoice
// Business rule: immutable after creation (Worker cannot edit/delete)
// ----------------------------------------------------------------------------
model Bill {
  id                       String           @id @default(uuid())
  billNumber               String           @unique @map("bill_number")
  retailerId               String           @map("retailer_id")
  workerId                 String           @map("worker_id")
  subtotal                 Decimal          @db.Decimal(12, 2)
  discount                 Decimal          @default(0)          @db.Decimal(12, 2)
  total                    Decimal          @db.Decimal(12, 2)
  paidAmount               Decimal          @default(0) @map("paid_amount")             @db.Decimal(12, 2)
  pendingAmount            Decimal          @map("pending_amount")                       @db.Decimal(12, 2)
  paymentMode              BillPaymentMode? @map("payment_mode")
  previousPendingAdded     Decimal?         @map("previous_pending_added")              @db.Decimal(12, 2)
  oldPendingPaymentApplied Decimal?         @map("old_pending_payment_applied")         @db.Decimal(12, 2)
  status                   BillStatus
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt      @map("updated_at")

  // Relations
  retailer       Retailer        @relation(fields: [retailerId], references: [id])
  worker         User            @relation("WorkerBills", fields: [workerId], references: [id])
  items          BillItem[]
  paymentHistory PaymentRecord[]
  ledgerEntries  LedgerEntry[]
  voidLog        VoidedBillLog?

  @@index([retailerId])
  @@index([workerId])
  @@index([createdAt])
  @@map("bills")
}

// ----------------------------------------------------------------------------
// BillItem — Individual product line within a Bill
// ----------------------------------------------------------------------------
model BillItem {
  id        String  @id @default(uuid())
  billId    String  @map("bill_id")
  productId String  @map("product_id")
  quantity  Int     // In PET units
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(12, 2) // (quantity * price) - discount

  // Relations
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
  @@map("bill_items")
}

// ----------------------------------------------------------------------------
// PaymentRecord — Historical partial/full payment applied against a Bill
// ----------------------------------------------------------------------------
model PaymentRecord {
  id          String          @id @default(uuid())
  billId      String          @map("bill_id")
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  paymentMode BillPaymentMode @map("payment_mode")
  notes       String?

  // Relations
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

// ----------------------------------------------------------------------------
// PriceHistory — Audit log when Admin changes a product's default price
// ----------------------------------------------------------------------------
model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(10, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(10, 2)
  changedBy String   @map("changed_by") // Admin user ID
  date      DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id])
  admin   User    @relation("AdminPriceChanges", fields: [changedBy], references: [id])

  @@index([productId])
  @@map("price_history")
}

// ----------------------------------------------------------------------------
// VoidedBillLog — Soft-delete audit trail for cancelled bills
// Business rule: bills are NEVER hard-deleted; prevents "ghost transactions"
// ----------------------------------------------------------------------------
model VoidedBillLog {
  id        String   @id @default(uuid())
  billId    String   @unique @map("bill_id")  // One void log per bill
  workerId  String   @map("worker_id")        // Worker who originally created the bill
  voidedAt  DateTime @default(now()) @map("voided_at")
  billValue Decimal  @map("bill_value") @db.Decimal(12, 2)
  reason    String   // Required explanation

  // Relations
  bill   Bill @relation(fields: [billId], references: [id])
  worker User @relation("WorkerVoids", fields: [workerId], references: [id])

  @@map("voided_bill_logs")
}

// ----------------------------------------------------------------------------
// Expense — Daily business expense tracking
// ----------------------------------------------------------------------------
model Expense {
  id          String          @id @default(uuid())
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  description String?
  date        DateTime        @default(now())
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  createdBy User @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([date])
  @@index([category])
  @@map("expenses")
}

// ----------------------------------------------------------------------------
// RGBItem — A type of returnable glass bottle crate (e.g. "Coca Cola RGB")
// Standalone — not linked to the Product catalog.
// stockQuantity tracks crates physically in the warehouse.
// ----------------------------------------------------------------------------
model RGBItem {
  id            String   @id @default(uuid())
  name          String   @unique              // e.g. "Coca Cola RGB", "Pepsi RGB"
  stockQuantity Int      @default(0) @map("stock_quantity")
  lastUpdated   DateTime @updatedAt           @map("last_updated")

  // Relations
  retailerBalances RGBRetailerBalance[]
  transactions     RGBTransaction[]

  @@map("rgb_items")
}

// ----------------------------------------------------------------------------
// RGBRetailerBalance — Per-retailer per-item outstanding crate balance
// balance > 0 means retailer currently owes that many crates back.
// @@unique enforces one balance record per (retailer, item) pair.
// ----------------------------------------------------------------------------
model RGBRetailerBalance {
  id         String   @id @default(uuid())
  retailerId String   @map("retailer_id")
  rgbItemId  String   @map("rgb_item_id")
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  retailer Retailer @relation(fields: [retailerId], references: [id])
  rgbItem  RGBItem  @relation(fields: [rgbItemId], references: [id])

  @@unique([retailerId, rgbItemId])
  @@map("rgb_retailer_balances")
}

// ----------------------------------------------------------------------------
// RGBTransaction — Audit log for every crate issue / return
// saleId and workerId are loose strings (no FK) so log survives even if
// the related Sale or User is removed in the future.
// ----------------------------------------------------------------------------
model RGBTransaction {
  id         String             @id @default(uuid())
  retailerId String             @map("retailer_id")
  rgbItemId  String             @map("rgb_item_id")
  type       RGBTransactionType
  quantity   Int
  saleId     String?            @map("sale_id")   // loose FK — no cascade needed
  workerId   String?            @map("worker_id")  // loose FK
  createdAt  DateTime           @default(now()) @map("created_at")

  // Relations
  rgbItem RGBItem @relation(fields: [rgbItemId], references: [id])

  @@index([retailerId])
  @@index([rgbItemId])
  @@map("rgb_transactions")
}

// ----------------------------------------------------------------------------
// PaymentReminder — A promised future payment logged against a retailer
// Retailers often pay bills partially and promise the balance on a specific
// date. This model tracks those promises for dashboard alerting.
// onDelete: Restrict on retailer — a retailer with open reminders cannot be
// deleted without first resolving or cancelling them (prevents orphaned alerts).
// createdById references User — the single auth model for both admin & worker.
// ----------------------------------------------------------------------------
model PaymentReminder {
  id          String         @id @default(cuid())
  retailerId  String         @map("retailer_id")
  amount      Decimal        @db.Decimal(12, 2)
  dueDate     DateTime       @map("due_date")
  note        String?
  status      ReminderStatus @default(PENDING)
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt       @map("updated_at")

  // Relations
  // onDelete: Restrict — prevents deleting a retailer who still has open reminders
  retailer  Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("ReminderCreator", fields: [createdById], references: [id])

  @@index([retailerId])
  @@index([dueDate, status])
  @@map("payment_reminders")
}
